# sftp_avl2db 运行配置（随仓库提交，可直接被 load_profiles() 读取）。
# 改完重启进程即可生效（load_profiles() 读一次并冻结配置对象）。
# 新环境初始化时按实际环境改值即可；.env.example 同值，主要提供键注释。
#
# 唯一配置来源，不读系统环境变量，配置来源没有覆盖入口，也没有别的解析入口。
# 语法只认「整行 # 注释」和 KEY=VALUE，不支持引号 / 插值 / 行内注释。
# 缺键、非整数、或数值不合法一律 fail-fast，没有默认值、没有项目级兜底。
# 查看当前生效值：python -c "from sftp_avl2db import load_profiles; print(load_profiles())"
# （repr 会自动屏蔽 SFTP_PASSWORD。）
#
# 【粒度】轮询 / 清理 / 批次 / 分表数全部按 AVL（也就是每个 db）声明，
# 键前缀恒为 AVL 名：<AVL>_*。没有 <项目名>_* 这类键，也不会回落到项目级配置。
# 项目名（opportunity_recall / loss_control / diagnosis）**只**决定目录：
#   runtime/files/{项目名}/      本地 AVL
#   runtime/sqlite_db/{项目名}/  输出的 {AVL}.db
# 下面用注释按项目分块只是为了好读，分块不参与任何配置解析。
# 每个 AVL 各起一个进程、各写一个 db；AVL 清单在 config.py::_AVLS，
# 表结构在 table_schemas.py，AVL 归属 / 解析器 / 是否分表在 avl_specs.py。
# 表名不用配：固定表就叫 {AVL}，分表叫 {AVL}_{分表号}，由写入侧 table_name() 派生。
#
# 每个 AVL 必需的 5 个运行参数：
#   <AVL>_BATCH_SIZE              单批提交行数（正整数）
#   <AVL>_DATA_EXPIRE_DAYS       库表数据保留天数（正整数，按 op_time 判定）
#   <AVL>_LOCAL_FILE_EXPIRE_DAYS 本地 .AVL 文件保留天数（正整数，按 mtime 判定）
#   <AVL>_POLL_INTERVAL_SECONDS  常驻轮询间隔秒数（正整数）
#   <AVL>_PURGE_CYCLE_DAYS      库表清理轮转周期（非负整数）：
#                               0 = 每轮全量清；1 = 每天全量清一次；
#                               N = 每天只清 1/N 的分表、N 天轮完一圈
#                               （固定表不参与轮转，仍每天全清一次）
# 分表 AVL 另需 <AVL>_NUM_TABLES（正整数），没有项目级兜底键。
#
# 全量替换模式（全部 AVL 共用的 1 个开关）：
#   AVL_DROP_BEFORE_INSERT       0=关闭 / 1=开启；开启后每次写入最新 AVL
#                                之前先 DROP 本 AVL 全部目标表并重建，
#                                只保留本批数据，不再按主键追加历史行。
#                                可用 <AVL>_DROP_BEFORE_INSERT 单独覆盖。
#
# 本仓库按当前约定把 sftp_avl2db/.env 一并提交，里面就是实际生效的字符串
# （含 SFTP_PASSWORD，不是占位值、无需部署前替换）；.env.example 同值，
# 主要提供键注释，不替代实际 .env。
# 运行时产出默认落在同目录 runtime/，不提交（见 .gitignore）。

# ===== SFTP（全部 AVL 共用）=====
SFTP_HOST=134.80.199.252
SFTP_PORT=22
SFTP_USERNAME=wangsi
SFTP_PASSWORD=W_s173O
SFTP_REMOTE_PATH=/ftpdata2/data_reverse/wangsi/aifile

# ===== 全量替换模式（全部 AVL 共用）=====
# 0 = 关闭（默认）：按主键 INSERT ... ON CONFLICT DO UPDATE 原地覆盖，历史行由过期清理管控。
# 1 = 开启：写入最新 AVL 前先 DROP 并重建全部目标表，只保留本批数据。
AVL_DROP_BEFORE_INSERT=0

# ===========================================================================
# 项目 opportunity_recall：F09554 / F09555 / F09556
# 每个 AVL 一个 {AVL}.db，落在 sqlite_db/opportunity_recall/，表名就是 {AVL}
# 固定表只有一张，PURGE_CYCLE_DAYS=1 即每天全量清一次。
# ===========================================================================
F09554_BATCH_SIZE=10000
F09554_DATA_EXPIRE_DAYS=3
F09554_LOCAL_FILE_EXPIRE_DAYS=3
F09554_POLL_INTERVAL_SECONDS=900
F09554_PURGE_CYCLE_DAYS=1

F09555_BATCH_SIZE=10000
F09555_DATA_EXPIRE_DAYS=3
F09555_LOCAL_FILE_EXPIRE_DAYS=3
F09555_POLL_INTERVAL_SECONDS=900
F09555_PURGE_CYCLE_DAYS=1

F09556_BATCH_SIZE=10000
F09556_DATA_EXPIRE_DAYS=3
F09556_LOCAL_FILE_EXPIRE_DAYS=3
F09556_POLL_INTERVAL_SECONDS=900
F09556_PURGE_CYCLE_DAYS=1

# ===========================================================================
# 项目 loss_control：F09591
# 单库内按 crc32(product_no) % F09591_NUM_TABLES 分表，表名 F09591_{分表号}
# 数据 / 本地文件均保留 3 天；清理周期取 7 天轮完（每天只清约 1/7 的分表）。
# ⚠ 改 NUM_TABLES 会改变「号码 → 分表」映射：必须停写、重灌全量 AVL。
# ===========================================================================
F09591_BATCH_SIZE=100000
F09591_DATA_EXPIRE_DAYS=3
F09591_LOCAL_FILE_EXPIRE_DAYS=3
F09591_POLL_INTERVAL_SECONDS=900
F09591_PURGE_CYCLE_DAYS=7
F09591_NUM_TABLES=128

