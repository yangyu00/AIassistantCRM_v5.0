# ===========================================================================
# 项目 diagnosis：F09633（用户场景对应关系，千万级行，唯一分表的诊断表）
# 按 crc32(product_no) % F09633_NUM_TABLES 分表，表名 F09633_{分表号}；
# 其余 7 张维表仍是固定表 {AVL}，不配 NUM_TABLES。
# 分表多、op_time 无索引，清理按 7 天轮转：每天只扫约 1/7 的分表。
# 数据保留 30 天，峰值约 30 + 7 - 1 = 36 天。
# ⚠ 改 NUM_TABLES 会改变「号码 → 分表」映射：必须停写、重灌全量 AVL；
#   在线侧 services/.env 的分表数也要同步成相同的值。
# ===========================================================================
F09633_BATCH_SIZE=10000
F09633_DATA_EXPIRE_DAYS=30
F09633_LOCAL_FILE_EXPIRE_DAYS=7
F09633_POLL_INTERVAL_SECONDS=1800
F09633_PURGE_CYCLE_DAYS=7
F09633_NUM_TABLES=128
