# ===========================================================================
# 项目 diagnosis：F09633（用户场景对应关系，千万级行，唯一分表的诊断表）
# 按 crc32(product_no) % F09633_NUM_TABLES 分表，表名 F09633_{分表号}；
# 其余 7 张维表仍是固定表 {AVL}，不配 NUM_TABLES。
# 分表多、op_time 无索引，清理按 7 天轮转：每天只扫约 1/7 的分表。
# 库表数据保留 365 天；按 7 天轮转时库内峰值约 365 + 7 - 1 = 371 天。
# ⚠ 改 NUM_TABLES 会改变「号码 → 分表」映射：必须停写、重灌全量 AVL；
#   在线侧 services/.env 的分表数也要同步成相同的值。
# ===========================================================================
F09633_BATCH_SIZE=100000
F09633_DATA_EXPIRE_DAYS=365
F09633_LOCAL_FILE_EXPIRE_DAYS=3
F09633_POLL_INTERVAL_SECONDS=900
F09633_PURGE_CYCLE_DAYS=7
F09633_NUM_TABLES=128
F09633_DROP_BEFORE_INSERT=1

# ---- 临时吞吐开关（8 亿条 / 8 小时窗口，用完必须改回 0 并重启）----
# 1 = 仅对 F09633 的写入连接关闭「同步」与「回滚日志」：
#     PRAGMA journal_mode=OFF + PRAGMA synchronous=OFF（关闭 fsync 与 WAL / rollback journal）
# 0 = 恢复默认 PRAGMA journal_mode=WAL + PRAGMA synchronous=NORMAL（安全口径）
# 可选键，不计入 68 个必需键；不写等价于 0。只认 0/1，其它值启动 fail-fast。
# 背景：上游每日全量实为约 8 亿条（此前按 8000 万条估算），需在 8 小时内灌完。
# ⚠ 风险（执行前务必读 sftp_avl2db/README.md 第 5 节「临时吞吐模式」）：
#   - 进程崩溃 / 断电 / kill -9 可能直接损坏整个 F09633.db，不只是丢最后一批；
#   - 双套表原子切换的 128 组 RENAME 事务失去回滚能力，中途失败会留下半切换 schema；
#   - 关闭 WAL 后切换事务期间在线侧读连接可能撞上锁或读到不一致的表集合。
#   执行前备份 F09633.db，安排在业务低峰，并确认在线侧可容忍短暂读抖动。
# 恢复：导入完成、核对 _avl_meta 水位与当前套数据后，把本键改回 0，
#       重启 F09633 写入进程（配置对象首次加载后冻结，必须重启）；
#       之后首次连接会重新执行 PRAGMA journal_mode=WAL，库恢复 WAL + NORMAL。
# 以后若缩减数据规模或改用 MySQL LOAD DATA INFILE，把本键删除 / 置 0 即可。
F09633_SYNC_JOURNAL_OFF=1

# ---- 崩溃兜底：进程启动时检查 F09633.db，损坏则直接删除并重建空库 ----
# 1 = 启动时除快速检查外，再跑 PRAGMA quick_check 全表页校验（能抓中间页损坏）
# 0 = 默认，只做毫秒级快速检查：文件头 / 能否打开 / 128 张当前套表 + _avl_meta
#     是否齐全 / 每张表 B-tree 根页可读。能抓崩溃截断、根页写坏、原子切换到
#     一半留下的半套 schema，但这三类之外的中间页损坏抓不到。
# ⚠ 置 1 会对 8 亿行全库扫描、耗时小时级，直接吃掉 8 小时窗口，只建议在
#   非导入窗口人工开一次做体检，用完改回 0 并重启。不改代码，可选键缺省 0。
# 重建时自动清空 .fetched 清单与失败隔离标记，强制本轮重灌；损坏库连同
# -wal / -shm / -journal 残留一起直接删除，不改名、不保留任何副本，立即
# 释放磁盘空间。需要事后取证请在启动前自行做文件级备份（详见 README 第 5 节）。
F09633_STARTUP_FULL_CHECK=0

# ---- P0 运行语义说明（整行注释，不参与配置解析，不改变 68 键契约）----
# F09633 上游每日全量约 8 亿条，POLL_INTERVAL_SECONDS=900 只决定「多久
# 检查一次远程文件是否到达」，不是导入调度周期：已成功入库的文件由
# runtime/state/F09633.fetched 清单跳过，单文件全量导入耗时可能远超轮询间隔。
# DROP_BEFORE_INSERT=1 配合双套表原子切换（P2）：数据先灌入 staging 套，
# 全部完成后单事务 RENAME 成当前套，在线侧全程读当前套、无空窗；导入失败时
# 当前套完全不受影响。代价是磁盘峰值约两套数据（≥25GB），需预留空间。
# 同一远程文件连续 2 次入库失败会被隔离到
# runtime/state/F09633.drop_quarantine，停止自动重试并打 ERROR；确认上游
# 文件与磁盘空间后，删除标记中该行或用 --force-reload 人工重跑。
# 控损 F09591 / 断供兜底、商机 F09554~56 不受以上收敛与清理跳过影响。

