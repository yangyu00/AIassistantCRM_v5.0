# sftp_avl2db 配置模板。复制成同目录下的 .env 后按环境填写：
#     cp sftp_avl2db/.env.example sftp_avl2db/.env
# 改完重启进程即可生效（load_profiles() 读一次并冻结配置对象）。
#
# 唯一配置来源，不读系统环境变量，没有路径覆盖，也没有别的配置入口。
# 语法只认「整行 # 注释」和 KEY=VALUE，不支持引号 / 插值 / 行内注释。
# 缺必需键或非正整数会直接报错，不会静默用默认值。
# 查看当前生效值：python -c "from sftp_avl2db import load_profiles; print(load_profiles())"
# （repr 会自动屏蔽 SFTP_PASSWORD。）
#
# 项目名（opportunity_recall / loss_control / diagnosis）既是 .env 键前缀，也是运行时目录名：
#   runtime/files/{项目名}/      本地 AVL
#   runtime/sqlite_db/{项目名}/  输出的 {AVL}.db
# 同一项目下每个 AVL 各起一个进程、各写一个 db；AVL 清单在 config.py::_AVLS，
# 表结构在 table_schemas.py，AVL 归属 / 解析器 / 是否分表在 avl_specs.py 与 config.py::_AVLS。
# 表名不用配：固定表就叫 {AVL}，分表叫 {AVL}_{分表号}，由写入侧 table_name() 派生。
#
# 安全做法：把 sftp_avl2db/.env 加入 .gitignore，只在本地 / 部署机上填真实
# 凭据，仓库里只保留这份脱敏模板。
# 运行时产出默认落在同目录 runtime/，也不要提交（见 .gitignore）。

# ===== SFTP（全部 AVL 共用）=====
SFTP_HOST=134.80.199.252
SFTP_PORT=22
SFTP_USERNAME=wangsi
SFTP_PASSWORD=<填入真实密码>
SFTP_REMOTE_PATH=/ftpdata2/data_reverse/wangsi/aifile

# ===== 项目 opportunity_recall（AVL：F09554 / F09555 / F09556）=====
# 每个 AVL 一个 {AVL}.db，落在 sqlite_db/opportunity_recall/，表名就是 {AVL}
OPPORTUNITY_RECALL_BATCH_SIZE=10000
OPPORTUNITY_RECALL_DATA_EXPIRE_DAYS=30
OPPORTUNITY_RECALL_LOCAL_FILE_EXPIRE_DAYS=7
OPPORTUNITY_RECALL_POLL_INTERVAL_SECONDS=600

# ===== 项目 loss_control（AVL：F09591）=====
# 单库内按 crc32(product_no) % NUM_TABLES 分表，表名 {AVL}_{分表号}
# 控损库数据与本地 AVL 均保留 3 天
LOSS_CONTROL_BATCH_SIZE=5000
LOSS_CONTROL_DATA_EXPIRE_DAYS=3
LOSS_CONTROL_LOCAL_FILE_EXPIRE_DAYS=3
LOSS_CONTROL_POLL_INTERVAL_SECONDS=1800
LOSS_CONTROL_NUM_TABLES=128

# ===== 项目 diagnosis（诊断新线 8 个 AVL：F09627~F09633 / F09635）=====
# 每张表一个 {AVL}.db，落在 sqlite_db/diagnosis/。其中 F09633（用户场景对应关系，
# 千万级行）按 crc32(product_no) % F09633_NUM_TABLES 分表，表名 F09633_{分表号}；
# 其余 7 张维表仍是固定表 {AVL}，不配 NUM_TABLES。维表按主键覆盖最新批次，
# 数据保留 30 天。
DIAGNOSIS_BATCH_SIZE=10000
DIAGNOSIS_DATA_EXPIRE_DAYS=30
DIAGNOSIS_LOCAL_FILE_EXPIRE_DAYS=7
DIAGNOSIS_POLL_INTERVAL_SECONDS=1800
# 分表数只作用于 F09633：<AVL>_NUM_TABLES 优先于项目级 <项目>_NUM_TABLES，
# 所以这里不会让同项目的 7 张维表跟着分表。
# ⚠ 改这个值会改变「号码 → 分表」的映射：必须停写、重灌 F09633 全量 AVL，
#   不能热改；按当前业务口径不做历史单表迁移。
F09633_NUM_TABLES=128
