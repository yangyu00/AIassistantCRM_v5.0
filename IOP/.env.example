# IOP 配置说明（主要提供键含义与注释）。实际生效的是同目录 .env，
# 按当前约定 .env 允许随仓库入库；新环境初始化时才需要复制：
#     cp IOP/.env.example IOP/.env
# 改完重启进程即可生效（IOPClient() 构造时读取，配置对象随后冻结）。
#
# IOP/.env 是唯一配置来源，不读系统环境变量，也没有覆盖入口。
# 语法只认「整行 # 注释」和 KEY=VALUE，不支持引号 / 插值 / 行内注释。
# 缺键或数值填错会回落到 config.py 里的内置默认值（不会报错）。
# 查看当前生效值：python -c "from IOP import IOPConfig; print(IOPConfig.load())"
# （repr 会自动屏蔽 secret。）

# ===== token 端点与凭据 =====
# 上游只提供 http 明文端点；凭据以 urlencode 表单串提交，不接受 Authorization 头。
# 按当前约定 IOP/.env 随仓库入库（含明文凭据），部署时按实际环境替换；
# 本文件只提供键注释，不用于替代 .env。对外分发前请评估凭据暴露风险。
IOP_TOKEN_HOST=134.80.220.55
IOP_TOKEN_PORT=80
IOP_TOKEN_ID=<填入 client_id>
IOP_TOKEN_SECRET=<填入 client_secret>

# ===== 标签查询（CustInfo）端点 =====
# VERSION / TYPE 原样进请求体；access_token 按上游要求放在 URL 查询串。
IOP_CUSTINFO_HOST=134.80.220.55
IOP_CUSTINFO_PORT=80
IOP_CUSTINFO_VERSION=1.0.1
IOP_CUSTINFO_TYPE=M

# ===== 超时（秒）=====
# 三项传给 aiohttp.ClientTimeout；填 0 / 负数 / 过小值会回落到内置默认值，
# 避免请求立刻超时（aiohttp 里 total=0 并不是「不限时」）。
IOP_TIMEOUT_TOTAL=3
IOP_TIMEOUT_CONNECT=1
IOP_TIMEOUT_SOCK_READ=2

# ===== 重试 / 退避 / 冷却 =====
# MAX_ATTEMPTS 是「单轮请求总次数」，不是「重试次数」，硬上限 20。
# 退避 = min(BASE * FACTOR^(失败次数-1), MAX)，单位秒。
# COOLDOWN 是一轮全失败后不再打认证服务的秒数；填 0 表示不冷却。
IOP_RETRY_MAX_ATTEMPTS=4
IOP_RETRY_BACKOFF_BASE=0.2
IOP_RETRY_BACKOFF_FACTOR=2
IOP_RETRY_BACKOFF_MAX=2
IOP_RETRY_COOLDOWN=5

# ===== token 有效期换算（秒）=====
# 实际有效期 = min(max(上游 expires_in - REFRESH_BUFFER, MIN_LIFETIME), 上游 expires_in)
# 上游值非数字 / 非正 / 超过 MAX_EXPIRES_IN 时由这里兜底或截断。
IOP_LIFETIME_DEFAULT_EXPIRES_IN=600
IOP_LIFETIME_REFRESH_BUFFER=360
IOP_LIFETIME_MIN_LIFETIME=60
IOP_LIFETIME_MAX_EXPIRES_IN=86400
