# IOP 唯一配置文件（与 config.py 同目录，不依赖启动时的当前工作目录）
# 改完重启进程即可生效：IOPClient() 构造时读取，配置对象随后冻结。
# 语法只认「整行 # 注释」和 KEY=VALUE，不支持引号 / 插值 / 行内注释。
# 不读系统环境变量，也没有别的覆盖入口；缺键或数值填错会回落到 config.py
# 里的内置默认值（不会报错）。

# ===== token 端点与凭据 =====
# 上游只提供 http 明文端点；client_id / client_secret 以 urlencode 表单串提交。
# 这两项按当前约定以实际字符串随仓库入库，本文件就是唯一生效来源，
# 不是占位值、无需部署前替换。
IOP_TOKEN_HOST=134.80.220.55
IOP_TOKEN_PORT=80
IOP_TOKEN_ID=202408131154527921000059
IOP_TOKEN_SECRET=8bd777c80673af7833105f5bf4219a84

# ===== 标签查询（CustInfo）端点 =====
# VERSION / TYPE 会原样放进请求体；access_token 按上游要求放在 URL 查询串。
IOP_CUSTINFO_HOST=134.80.220.55
IOP_CUSTINFO_PORT=80
IOP_CUSTINFO_VERSION=1.0.1
IOP_CUSTINFO_TYPE=M

# ===== 超时（秒）=====
# 三项都会传给 aiohttp.ClientTimeout；填 0 / 负数 / 过小值会回落到内置默认值，
# 避免请求立刻超时（aiohttp 里 total=0 并不是「不限时」）。
IOP_TIMEOUT_TOTAL=3
IOP_TIMEOUT_CONNECT=1
IOP_TIMEOUT_SOCK_READ=2

# ===== 重试 / 退避 / 冷却 =====
# MAX_ATTEMPTS 是「单轮请求总次数」，不是「重试次数」，硬上限 20。
# 退避 = min(BASE * FACTOR^(失败次数-1), MAX)，单位秒。
# COOLDOWN 是一轮全失败后的冷却秒数，冷却期内不打认证服务；填 0 表示不冷却。
IOP_RETRY_MAX_ATTEMPTS=4
IOP_RETRY_BACKOFF_BASE=0.2
IOP_RETRY_BACKOFF_FACTOR=2
IOP_RETRY_BACKOFF_MAX=2
IOP_RETRY_COOLDOWN=5

# ===== token 有效期换算（秒）=====
# 实际有效期 = min(max(v - REFRESH_BUFFER, MIN_LIFETIME), v)
#   其中 v = min(float(上游 expires_in), MAX_EXPIRES_IN)
#   （旧注释漏了 MAX_EXPIRES_IN 截断这一步，600000 秒会被误读成 599640s）
# 缺字段 / 非法值才回落 DEFAULT_EXPIRES_IN=600 → 600-360=240s；上游给 600000 时
# 实际 ttl=599640s（约 6.94 天），不需要频繁刷新。
# 上游值非数字 / 非正 / 超过 MAX_EXPIRES_IN 时由这里兜底或截断。
IOP_LIFETIME_DEFAULT_EXPIRES_IN=600
IOP_LIFETIME_REFRESH_BUFFER=360
IOP_LIFETIME_MIN_LIFETIME=60
IOP_LIFETIME_MAX_EXPIRES_IN=604800

# ===== 有效期字段兼容与 token 失效自愈（本次修复）=====
# token 响应里有效期字段的候选名，按序取第一个存在的；命中别名会记 INFO，
# 一个都没有则记 ERROR 并回落 600s（以前连日志都没有，会莫名每 4 分钟刷新）。
IOP_EXPIRES_IN_FIELDS=expires_in,expiresIn,expire_in

# 标签查询返回这些业务码，或 res_desc/error 描述里出现这些关键词，
# 判定为「token 失效」：invalidate → 重刷一次 → 用新 token 重试一次标签查询。
IOP_AUTH_FAILURE_CODES=401,403,1001,1002,10001,10102,30001
IOP_AUTH_FAILURE_KEYWORDS=access_token,accesstoken,token,invalid,expired,unauthorized,unauthenticated,not valid,认证,令牌,失效,无效,过期,未授权,未登录
# 0 关闭自动重刷（只记日志），1 开启
IOP_AUTH_RETRY_ENABLED=1

# ===== 后台 token 续期（把刷新移出用户请求关键路径）=====
IOP_BACKGROUND_REFRESH_ENABLED=1
# 到期前多少秒触发续期
IOP_BACKGROUND_REFRESH_LEAD=60
# 刷新循环的最短间隔，防止无 token 时高频重试
IOP_BACKGROUND_REFRESH_MIN_INTERVAL=30
# lifespan 启动预热最长等待秒数；超时不阻塞服务启动
IOP_WARMUP_TIMEOUT=5
