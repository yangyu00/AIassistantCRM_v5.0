# ===== 明文凭据：IOP/.env 与 sftp_avl2db/.env 均按当前约定随仓库入库 =====
.env
!IOP/.env
!sftp_avl2db/.env
services/.env
!IOP/.env.example
!sftp_avl2db/.env.example
# call_stat/.env 不含凭据，作为默认配置随仓库提交
!call_stat/.env

# ===== 运行时产出（写入进程生成，在线侧只读）=====
sftp_avl2db/runtime/*
!sftp_avl2db/runtime/.gitkeep
local_excel2db/runtime/*
!local_excel2db/runtime/.gitkeep
call_stat/runtime/*
!call_stat/runtime/.gitkeep
log/
*.db
*.db-journal
*.log
*.fetched
*.lock
*.AVL.tmp

# ===== Python =====
__pycache__/
*.py[cod]
.pytest_cache/
