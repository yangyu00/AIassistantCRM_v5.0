# call_stat 配置模板。复制成同目录下的 .env 后按环境填写：
#     cp call_stat/.env.example call_stat/.env
# 改完重启在线进程生效（get_config() 首次调用时读一次并冻结配置对象）。
#
# 唯一配置来源，不读系统环境变量，也不读项目根 config.yaml，没有第二套解析入口。
# 语法只认「整行 # 注释」和 KEY=VALUE，不支持引号 / 插值 / 行内注释。
# 缺文件 / 缺键 / 数值非法一律回落本文件里的默认值并打印 WARNING，
# 不阻断在线服务（调用量统计是旁路功能）。
# 查看当前生效值：python -c "from call_stat import get_config; print(get_config())"
#
# 产物边界：库与 CSV 恒落在 call_stat/runtime/ 下，
# CALL_STAT_DB_FILENAME / CALL_STAT_EXPORT_DIRNAME 只允许纯文件名，
# 写 ../ 或绝对路径会被拒绝并回落默认。runtime/ 不要提交（见 .gitignore）。

# ===== 缓冲写入 =====
# 当天调用量先在内存累计，达到该次数才写一次 SQLite；必须为正整数。
# 调小可缩小强杀/崩溃时丢失的尾部窗口（默认 100 → 最多丢 99 次）。
CALL_STAT_FLUSH_THRESHOLD=100

# ===== 在线查询路由 =====
# GET 路径，由 main.py 的 app.include_router(call_stat.build_router()) 注册。
CALL_STAT_QUERY_PATH=/api/callStat

# ===== 包内产物 =====
CALL_STAT_DB_FILENAME=call_sum.db
CALL_STAT_EXPORT_DIRNAME=export
