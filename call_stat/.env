# call_stat 唯一配置来源；改完重启在线进程生效。
# 语法：整行 # 注释 + KEY=VALUE，不支持引号 / 插值 / 行内注释。
# 所有产物恒落在同目录 runtime/ 下，下面两个名字只能是纯文件名，不能带路径。

# 当天调用量在内存累计到该次数才写一次 SQLite（正整数）
CALL_STAT_FLUSH_THRESHOLD=100

# GET 查询路径，由 main.py 的 build_router() 注册
CALL_STAT_QUERY_PATH=/api/callStat

# runtime/ 下的库文件名与 CSV 导出子目录名
CALL_STAT_DB_FILENAME=call_sum.db
CALL_STAT_EXPORT_DIRNAME=export
