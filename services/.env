# services 在线侧读取配置（实际生效文件）。
# .env.example 只是键注释模板，不替代本文件；本文件缺键或缺失时，回落到
# services/db_config.py 里的代码内默认值。在线侧只读本地库，没有凭据。
# 语法只认「整行 # 注释」和 KEY=VALUE，不支持引号 / 插值 / 行内注释。
# 改完重启在线进程生效（配置在首次装配时冻结并缓存）。

# ===== 业务库目录：{AVL_DB_ROOT}/{project}/{AVL}.db =====
AVL_DB_ROOT=sftp_avl2db/runtime/sqlite_db

# ===== 卖点维表库文件 =====
DIMENSIONS_DB=local_excel2db/runtime/sqlite_db/dimensions.db

# ===== 分表数（与写入侧各自声明，改值须同步并重灌对应 AVL）=====
LOSS_CONTROL_NUM_TABLES=128
F09633_NUM_TABLES=128

# ===== AVL 批次新鲜度窗口（按业务分别配置，非负整数）=====
# 写入侧在每个 {AVL}.db 的 _avl_meta 表里登记最新批次的 op_time。
# N = 只召回 op_time 落在 [最新批次-(N-1)天, 最新批次] 的记录；
# 多条查询再收敛到窗口内 op_time 最大的那一批（排除过时的残留行）。
# 商机回捞 / 控损：保留最近 2 个数据日期；诊断 8 张表：0 = 关闭过滤。
OPPORTUNITY_RECALL_FRESHNESS_WINDOW_DAYS=2
LOSS_CONTROL_FRESHNESS_WINDOW_DAYS=2
DIAGNOSIS_FRESHNESS_WINDOW_DAYS=0
